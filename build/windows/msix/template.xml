<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="deepseek-harness-shell.exe"
        Arguments=""
        InstallLocation="C:\Program Files\deepseek harness shell">
    </Installer>
    <PackageInformation
        PackageName="deepseek-harness-shell"
        PackageDisplayName="deepseek harness shell"
        PublisherName="CN=deepseek harness shell"
        PublisherDisplayName="deepseek harness shell"
        Version="0.1.1.0"
        PackageDescription="deepseek harness shell desktop application">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.deepseek.harness"
                Description="deepseek harness shell desktop application"
                DisplayName="deepseek harness shell"
                ExecutableName="deepseek-harness-shell.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>deepseek harness shell</DisplayName>
            <PublisherDisplayName>deepseek harness shell</PublisherDisplayName>
            <Description>deepseek harness shell desktop application</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="deepseek-harness-shell.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
